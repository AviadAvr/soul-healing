# ─── TinaCMS Cloud (production only) ───────────────────────────────
# For the local proof-of-concept you can ignore these — Tina runs in
# "local mode" and reads/writes the files in /content directly.
#
# For production:
#   1. Sign in at https://app.tina.io and create a project pointing at
#      this GitHub repo.
#   2. Copy the Client ID and a read-only Token below.
#   3. Rename this file to ".env".

NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=
GITHUB_BRANCH=main

